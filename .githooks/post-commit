#!/usr/bin/env bash
# post-commit — generate changelog entries for new commits on any branch
#
# This hook runs after every local commit.  It generates a changelog
# preview for any new commits since the last release tag.
#
# On protected branches (master/dev) it only shows a preview.
# On feature branches it also updates CHANGELOG.md so the change
# can be included in the next PR.
#
# Install:
#   git config core.hooksPath .githooks
#   chmod +x .githooks/post-commit

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Find previous release tag
find_prev_tag() {
    local tag
    tag="$(git describe --tags --abbrev=0 HEAD~1 2>/dev/null || true)"
    [ -n "$tag" ] && echo "$tag" && return
    tag="$(git describe --tags --abbrev=0 master 2>/dev/null || true)"
    [ -n "$tag" ] && echo "$tag" && return
    tag="$(git describe --tags --abbrev=0 origin/master 2>/dev/null || true)"
    [ -n "$tag" ] && echo "$tag" && return
    git tag --list 'v*' --sort=-version:refname | head -1 2>/dev/null || true
}

PREV_TAG="$(find_prev_tag)"
[ -z "$PREV_TAG" ] && exit 0

# Check if there are new commits since the tag
COUNT="$(git rev-list "$PREV_TAG..HEAD" --count 2>/dev/null || echo 0)"
[ "$COUNT" -eq 0 ] && exit 0

ENTRIES="$(bash scripts/generate-changelog.sh --stdout "$PREV_TAG" HEAD 2>/dev/null || true)"
[ -z "$ENTRIES" ] && exit 0

BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"

echo ""
echo "============================================"
echo "[post-commit] $COUNT new commit(s) since $PREV_TAG on '$BRANCH'"
echo "============================================"
echo "$ENTRIES"
echo "============================================"

case "$BRANCH" in
    master|dev)
        echo "[post-commit] Branch '$BRANCH' is protected — no files modified."
        echo "[post-commit] To apply: run 'bash scripts/generate-changelog.sh $PREV_TAG <new-tag>'"
        ;;
    *)
        # On feature branches: update CHANGELOG.md if not already present
        ENTRY_KEY="$(echo "$ENTRIES" | head -1 | sed 's/^## \[//;s/\].*//')"
        if grep -q "^## \[$ENTRY_KEY\]" CHANGELOG.md 2>/dev/null; then
            echo "[post-commit] Section '[$ENTRY_KEY]' already in CHANGELOG.md, skipping."
        else
            {
                echo ""
                echo "$ENTRIES"
            } >> CHANGELOG.md
            echo "[post-commit] CHANGELOG.md updated."
        fi
        echo "[post-commit] Review and commit before pushing:"
        echo "[post-commit]   git add CHANGELOG.md && git commit -m 'Update CHANGELOG.md'"
        ;;
esac
echo ""
